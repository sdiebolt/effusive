# Effusive Environment Configuration
# Copy this file to .env and update the paths for your system. Then, run effusive
# using:
#   uv run --env-file .env effusive

# Path to EchoFrame repository (required)
ECHOFRAME_PATH=/path/to/EchoFrame

# Directory containing the built echoframe_mex MEX (required for live DAS).
# Rebuild EchoFrame with -DEF_USE_FFDAS=ON so DAS uses the ffdas kernel.
ECHOFRAME_MEX_ROOT=/path/to/EchoFrame/echoframe/cpp/build

# Path to Verasonics Vantage installation (required)
VERASONICS_VPF_ROOT=/path/to/vantage/Vantage-X.X.X

# Path to MATLAB installation (optional, has default)
MATLAB_ROOT=/path/to/MATLAB/R20XXx
